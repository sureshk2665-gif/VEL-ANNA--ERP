# Copy to .env.local for local development (never commit .env.local).
# On Vercel, set these under Project → Settings → Environment Variables instead.

# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase → Project Settings → API → anon / publishable key (safe to expose in the browser)
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Optional: row id in the erp_data table (default "main"). Use a different id to keep a
# separate test data set in the same project.
# VITE_SUPABASE_ROW_ID=main

# Local testing without touching the shared database (browser-only storage):
# VITE_SUPABASE_URL=off
