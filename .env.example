# Copy to .env.local for local development (never commit .env.local).
# On Vercel, set these under Project → Settings → Environment Variables instead.

# Supabase → Project Settings → API (or the Connect dialog, React + Vite)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Setting VITE_SUPABASE_URL turns on Supabase Auth sign-in (secure setup, supabase/schema.sql).
# Optional:
# VITE_AUTH_EMAIL_DOMAIN=vipl-erp.local   # username "vipl1" signs in as vipl1@vipl-erp.local
# VITE_SUPABASE_ROW_ID=main               # use another id for a separate test data set
# VITE_AUTH_MODE=anon                     # old open mode, for a project still on schema-legacy-open.sql

# Local testing without touching any database (browser-only storage):
# VITE_SUPABASE_URL=off
